<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="AUTO"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Menu  FontSize="14" Height="25" VerticalAlignment="Top">
            <MenuItem Header="Одноканальные СМО">
                <MenuItem Tag="1.1" Click="MenuItem_Click" Header="Одноканальные с отказами в обслуживании" ></MenuItem>
                <MenuItem Tag="1.2" Click="MenuItem_Click" Header="Одноканальные с ограниченной длиной очереди" ></MenuItem>
                <MenuItem Tag="1.3" Click="MenuItem_Click" Header="Одноканальные с неограниченной длиной очереди"></MenuItem>
            </MenuItem>
            <MenuItem Header="Многоканальные СМО">
                <MenuItem Tag="2.1" Click="MenuItem_Click" Header="Многоканальные с отказами в обслуживании" ></MenuItem>
                <MenuItem Tag="2.2" Click="MenuItem_Click" Header="Многоканальные с ограниченной длиной очереди" ></MenuItem>
                <MenuItem Tag="2.3" Click="MenuItem_Click" Header="Многоканальные с неограниченной длиной очереди"></MenuItem>
            </MenuItem>
        </Menu>
        <Frame NavigationUIVisibility="Hidden" Grid.Row="1" x:Name="MainFrame"></Frame>
    </Grid>
</Window>
